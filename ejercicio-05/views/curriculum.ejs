<%- include("partials/head") %>
    <header>
        <img src="<%= curriculum.photo %>" alt="Fotografía de perfil de <%= curriculum.name %>" width="180">
        <div class="identity">
            <h1><%= curriculum.name %></h1>
            <p><%= curriculum.headline %></p>
        </div>
        <address>
            <ul>
                <% curriculum.links.forEach((link) => { %>
                    <li>
                        <span><%= link.label %>:</span>
                        <a href="<%= link.href %>"<% if (link.external) { %> target="_blank" rel="noopener"<% } %>><%= link.text %></a>
                    </li>
                <% }); %>
            </ul>
        </address>
    </header>

    <main id="main-content">
        <section>
            <h2>Perfil profesional</h2>
            <p><%= curriculum.profile.introduction %><strong><%= curriculum.profile.emphasis %></strong><%= curriculum.profile.description %></p>
        </section>

        <section>
            <h2>Formación académica</h2>
            <table>
                <caption>Estudios universitarios en curso</caption>
                <thead>
                    <tr>
                        <th scope="col">Institución</th>
                        <th scope="col">Carrera</th>
                        <th scope="col">Período</th>
                    </tr>
                </thead>
                <tbody id="education-list">
                    <% curriculum.education.forEach((program) => { %>
                        <tr>
                            <th scope="row"><%= program.institution %></th>
                            <td><%= program.degree %></td>
                            <td><time datetime="<%= program.startYear %>"><%= program.startYear %></time> - Actualidad</td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </section>

        <section id="projects-list">
            <h2>Proyectos académicos</h2>
            <%- include("partials/articles", { items: curriculum.projects }) %>
        </section>

        <section id="experience-list">
            <h2>Experiencia laboral</h2>
            <%- include("partials/articles", { items: curriculum.experience }) %>
        </section>

        <section>
            <h2>Habilidades</h2>
            <% curriculum.skills.forEach((group) => { %>
                <h3><%= group.title %></h3>
                <ul id="<%= group.container %>">
                    <% group.items.forEach((item) => { %>
                        <li><%= item %></li>
                    <% }); %>
                </ul>
            <% }); %>
        </section>

        <section>
            <h2>Voluntariado</h2>
            <% curriculum.volunteering.forEach((item) => { %>
                <article>
                    <h3><%= item.title %></h3>
                    <p>
                        <%= item.institution %> |
                        <time datetime="<%= item.startDate %>"><%= item.startLabel %></time> -
                        <time datetime="<%= item.endDate %>"><%= item.endLabel %></time>
                    </p>
                    <p><%= item.description %></p>
                </article>
            <% }); %>
        </section>

        <section>
            <h2>Reconocimientos</h2>
            <ul>
                <% curriculum.awards.forEach((award) => { %>
                    <li>
                        <%= award.description %>, de
                        <time datetime="<%= award.startDate %>"><%= award.startLabel %></time> a
                        <time datetime="<%= award.endDate %>"><%= award.endLabel %></time>.
                    </li>
                <% }); %>
            </ul>
        </section>

        <section>
            <h2>Idiomas</h2>
            <ul>
                <% curriculum.languages.forEach((language) => { %>
                    <li><%= language %></li>
                <% }); %>
            </ul>
        </section>

        <section id="contacto">
            <h2>Contacto</h2>
            <p>Completa el formulario para enviar un mensaje al servidor.</p>
            <% if (errors.length > 0) { %>
                <div class="form-errors" role="alert" tabindex="-1" autofocus>
                    <p><strong>Revisa los datos del formulario:</strong></p>
                    <ul>
                        <% errors.forEach((error) => { %>
                            <li><%= error %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>
            <form action="/contacto#contacto" method="post">
                <label for="contact-name">Nombre</label>
                <input id="contact-name" name="name" type="text" autocomplete="name"
                       required maxlength="100" value="<%= contact.name %>">

                <label for="contact-email">Correo electrónico</label>
                <input id="contact-email" name="email" type="email" autocomplete="email"
                       required maxlength="254" value="<%= contact.email %>">

                <label for="contact-message">Mensaje</label>
                <textarea id="contact-message" name="message" rows="6"
                          required maxlength="2000"><%= contact.message %></textarea>

                <button class="submit-button" type="submit">Enviar mensaje</button>
            </form>
        </section>
    </main>
    <footer>
        <p>Currículum de <%= curriculum.name %>.</p>
    </footer>
</body>
</html>
